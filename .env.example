# Chave usada para selar o cookie de sessão (nuxt-auth-utils). Mínimo 32 caracteres.
# Em desenvolvimento, uma chave é gerada automaticamente se esta variável não existir.
# Em produção é obrigatória.
NUXT_SESSION_PASSWORD=

# Caminho do arquivo do banco SQLite. Padrão: .data/ajuda-belem.db
# DB_PATH=.data/ajuda-belem.db

# Quando "true", cria (uma única vez) duas contas de servidor de demonstração
# na subida do servidor, com as credenciais impressas no log. Nunca habilite
# em um ambiente de produção real.
# SEED_DEMO_USERS=true
