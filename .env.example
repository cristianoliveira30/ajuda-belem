# Copie este arquivo para ".env". Com `docker compose up`, DATABASE_URL já é
# preenchido automaticamente pelo serviço `db` do docker-compose.yml — só
# precisa deste arquivo se for rodar `yarn dev` fora do Docker, apontando
# para um Postgres próprio (local ou gerenciado).
DATABASE_URL=postgres://ajuda_belem:ajuda_belem@localhost:5433/ajuda_belem

# Chave usada pelo Better Auth para assinar sessões/cookies. Gere uma nova
# para produção com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública onde a aplicação roda — usada pelo Better Auth para montar o
# callback do OAuth (ex.: <BETTER_AUTH_URL>/api/auth/callback/google) e como
# origem quando não dá para derivar do request. Em dev local:
BETTER_AUTH_URL=http://localhost:3000

# Credenciais do OAuth Client (tipo "Web application") criado no Google
# Cloud Console, com http://localhost:3000/api/auth/callback/google
# cadastrado como Authorized redirect URI. Sem isso preenchido, o botão
# "Continuar com Google" aparece na tela mas o login real falha.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
